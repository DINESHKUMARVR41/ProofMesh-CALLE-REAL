# Supabase — public values are safe in browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service-role key — server-side only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# CALL-E
CALLE_API_KEY=<calle-api-key>
CALLE_MODE=mock

# ProofMesh AI extraction (optional but recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# CALL-E live investigation
CALLE_API_KEY=
